# Modelo de configuração. Para personalizar: cp .env.example .env
# Sem o .env, o projeto usa estes mesmos valores, definidos no docker-compose.yml.
# O .env nunca vai para o Git. Não coloque segredos reais neste arquivo de exemplo.
# As credenciais abaixo protegem apenas o armazenamento local.

TODEOLHO_S3_CHAVE_DE_ACESSO=todeolho
TODEOLHO_S3_CHAVE_SECRETA=todeolho-local
TODEOLHO_S3_REGIAO=sa-east-1
TODEOLHO_S3_BUCKET_RAW=raw
TODEOLHO_S3_BUCKET_EXECUCOES=execucoes
TODEOLHO_S3_PORTA=7070

# Navegador de arquivos: http://localhost:7071
TODEOLHO_ARQUIVOS_PORTA=7071

# Porta do painel: http://localhost:8080
TODEOLHO_PAINEL_PORTA=8080

# Tarefas simultâneas dentro de um nível da DAG. Valores baixos poupam as APIs públicas.
TODEOLHO_CONCORRENCIA=2

# Jobs de compilação da imagem. Use 1 se a máquina tiver pouca memória.
TODEOLHO_BUILD_JOBS=2

# Nível de log: error, warn, info ou debug.
TODEOLHO_LOG=info

# As fontes atuais não exigem tokens. Para uma fonte autenticada futura, consulte
# a documentação dela para obter o token e o nome da variável de ambiente.
# Não coloque tokens reais neste arquivo de exemplo.
