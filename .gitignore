# Compilação
/target

# Configuração local e segredos: só o .env.example vai para o repositório
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.crt
credentials.json
credenciais.json
secrets.*
segredos.*
.aws/

# Dados ingeridos: ficam no volume do Docker, nunca no Git
/raw-local
/dados
*.zip
*.parquet

# Ambiente de cada pessoa
/.idea
/.vscode
*.iml
*.swp
.DS_Store
Thumbs.db

# Registros de execução
*.log

# Ferramentas de agente (skill Archify etc.): reinstaláveis, não versionadas
/.claude
/.agents
/skills-lock.json

# Recibos do Archify: o entregável é o .html + o .json-fonte
/docs/diagramas/*.finalize.json
/docs/diagramas/*.finalize-summary.json
/docs/diagramas/*.browser-check.json
/docs/diagramas/*.delivery.json
